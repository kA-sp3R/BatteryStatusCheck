<Window x:Class="DeviceBatteryStatus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Battery Status — Milestone 1" Width="1050" Height="470"
        MinWidth="760" MinHeight="340" Background="#080808" Foreground="#EEEEEE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="RefreshButton" Content="Refresh" DockPanel.Dock="Right"
                    Padding="16,5" Click="Refresh_Click" />
            <TextBlock Text="Device Battery Status" FontSize="22" Foreground="#44D62C" />
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Battery-monitoring foundation · USB 2.4 GHz only · Automatic refresh every 30 seconds. A receiver alone does not prove its peripheral is connected." />
        <DataGrid Grid.Row="2" x:Name="DeviceGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" Background="#151515" Foreground="#111111"
                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Peripheral / receiver" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Battery" Binding="{Binding Percentage}" Width="70" />
                <DataGridTextColumn Header="Reading" Binding="{Binding State}" Width="95" />
                <DataGridTextColumn Header="Charging" Binding="{Binding Charging}" Width="95" />
                <DataGridTextColumn Header="Link" Binding="{Binding Connection}" Width="90" />
                <DataGridTextColumn Header="Sample (local)" Binding="{Binding SampleTime}" Width="130" />
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Grid.Row="4" x:Name="SupportText" Margin="0,10,0,0" Foreground="#BBBBBB"
                   FontSize="11" TextWrapping="Wrap" />
    </Grid>
</Window>
