<Window x:Class="DeviceBatteryStatus.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Battery Status" Width="300" SizeToContent="Height" MaxHeight="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#080808" Foreground="#E3E9E2"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A8B5A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#182318"/>
                                <Setter Property="Foreground" Value="#44D62C"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#44D62C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#253425"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#172017"/>
            <Setter Property="Foreground" Value="#E3E9E2"/>
            <Setter Property="BorderBrush" Value="#354531"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="MaxWidth" Value="380"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#293428" BorderThickness="1" Background="#080808">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="13,8,8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="#44D62C" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="DEVICE BATTERIES" FontSize="10.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="#DCE8D8"/>
                <Button x:Name="RefreshButton" Grid.Column="2" Width="27" Margin="0,0,3,0"
                        Style="{StaticResource QuietButton}" Click="OnRefreshClick"
                        ToolTip="Refresh battery readings" AutomationProperties.Name="Refresh battery readings">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
                <Button Grid.Column="3" Width="27" Style="{StaticResource QuietButton}" Click="OnSettingsClick"
                        ToolTip="Open settings" AutomationProperties.Name="Open settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="DeviceScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              MaxHeight="392" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="DeviceList" Margin="0,0,0,3">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="12,0" Padding="0,7" MinHeight="50"
                                        BorderBrush="#162015" BorderThickness="0,0,0,1"
                                        ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="300"
                                        ToolTipService.ShowDuration="30000" Focusable="True"
                                        AutomationProperties.Name="{Binding AccessibilityText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="7" HorizontalAlignment="Left"
                                                VerticalAlignment="Top" Margin="0,2,0,0"
                                                Background="#111A10" BorderBrush="#263324" BorderThickness="1"
                                                ToolTip="{Binding DeviceIconToolTip}">
                                            <TextBlock Text="{Binding DeviceGlyph}" Foreground="#7F9B75"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,7,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PercentageText}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{Binding PercentageBrush}"
                                                           VerticalAlignment="Center" MaxWidth="160"
                                                           TextWrapping="Wrap" TextAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="9.5"
                                                       Foreground="#8B9887" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Height="2"
                                                         Margin="0,5,0,0" BorderThickness="0" Background="#1B2519"
                                                         Foreground="{Binding ProgressBrush}" Value="{Binding ProgressValue}"
                                                         Visibility="{Binding ProgressVisibility}"
                                                         IsHitTestVisible="False" Focusable="False"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Margin="22,22,22,25" Visibility="Collapsed">
                    <TextBlock Text="Waiting for peripherals" Foreground="#CAD8C6" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Connect a supported 2.4 GHz USB receiver.&#x0a;Unavailable readings are never guessed."
                               Foreground="#81917B" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="12,0,8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" FontSize="9" Foreground="#74836F"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Exit" FontSize="10" Style="{StaticResource QuietButton}"
                        Click="OnExitClick" ToolTip="Quit Device Battery Status"
                        AutomationProperties.Name="Quit Device Battery Status"/>
            </Grid>
        </Grid>
    </Border>
</Window>
